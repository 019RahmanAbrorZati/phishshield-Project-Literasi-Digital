{
  "manifest_version": 3,
  "name": "PhishShield",
  "version": "0.1.0",
  "description": "Ekstensi deteksi indikasi phishing berbasis Random Forest di sisi klien untuk literasi digital",
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "permissions": [
    "webNavigation",
    "storage",
    "activeTab",
    "scripting"
  ],
  "background": {
    "service_worker": "background/service_worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "PhishShield",
    "default_icon": {
      "16": "assets/icon16.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  }
}
